# 복사 후 파일명을 `.env.local`로 두고 값을 채웁니다. 커밋하지 마세요.

# 공공 API (서버 전용 — Route Handler에서만 사용)
BIZINFO_API_KEY=
PUBLIC_DATA_SERVICE_KEY=
SMES24_API_KEY=
SMES24_API_BASE=https://www.smes.go.kr/fnct/apiReqst/extPblancInfo
SMES24_DEFAULT_STRDT=
SMES24_DEFAULT_ENDDT=

# LLM — Google Gemini (서버 전용, 절대 NEXT_PUBLIC_ 사용 금지)
GEMINI_API_KEY=

# Supabase (서버 전용)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (클라이언트 공개)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron / admin
CRON_SECRET=

# Optional
GOV_MCP_JSON_PRETTY=false
PAYMENT_SECRET_KEY=
